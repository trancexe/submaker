# submaker configuration example
# Copy to .env or use `uv run submaker config`

# LLM Translation (OpenAI / OpenRouter / Groq / DeepSeek / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq Whisper Cloud API (Optional, for 10x faster transcription of 2-hour movies)
GROQ_API_KEY=
